# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite - loaded by frontend client)
# ------------------------------------------------------------------------------
# Firebase Web Client SDK Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google Maps Platform JavaScript API Key (Used by @vis.gl/react-google-maps)
# Free Maps Demo Key or restricted GCP Maps API key
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend Environment Variables (FastAPI - loaded by Python backend)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Firebase Admin SDK Credentials (Optional for local-sync mode, required for server-side admin)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Google Maps Routes & Distance Matrix API Key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Gemini API Key for AI Disaster Response Intelligence (Gemini 2.5 Flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
