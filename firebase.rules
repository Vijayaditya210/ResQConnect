rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Role-Based Access Control
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && (getUserData().role == role || getUserData().role == 'ADMIN');
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'ADMIN';
    }
    
    function isNGO() {
      return hasRole('NGO');
    }
    
    function isWarehouseManager() {
      return hasRole('WAREHOUSE_MANAGER');
    }
    
    function isLogistics() {
      return hasRole('VOLUNTEER_LOGISTICS');
    }

    // Disasters Collection: Public read, Admin write
    match /disasters/{disasterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Emergency Demands: Read by all, Create by NGO/Admin, Update by Authority/Logistics
    match /demands/{demandId} {
      allow read: if true;
      allow create: if isNGO() || isAdmin();
      allow update: if isNGO() || isWarehouseManager() || isAdmin() || isLogistics();
      allow delete: if isAdmin();
    }

    // Resource Inventory: Read by all, Update by Warehouse Managers / Admin
    match /resources/{resourceId} {
      allow read: if true;
      // Allow atomic allocation decrements when remaining stock is >= 0
      allow update: if (isWarehouseManager() || isAdmin()) && 
                      request.resource.data.available_quantity >= 0;
      allow create, delete: if isWarehouseManager() || isAdmin();
    }

    // Resource Centers / Warehouses
    match /resource_centers/{centerId} {
      allow read: if true;
      allow write: if isAdmin() || isWarehouseManager();
    }

    // Allocations Collection
    match /allocations/{allocationId} {
      allow read: if true;
      allow create, update: if isWarehouseManager() || isAdmin();
      allow delete: if isAdmin();
    }

    // Fleet Vehicles & GPS Telemetry
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isLogistics() || isAdmin();
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create: if isWarehouseManager() || isAdmin();
      allow update: if isLogistics() || isWarehouseManager() || isAdmin();
      allow delete: if isAdmin();
    }

    // Shelters Collection
    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if isAdmin() || isNGO();
    }

    // Real-Time Alerts Collection
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
